# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co

# Anon key (safe to expose in client): Supabase Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ─── Anthropic ────────────────────────────────────────────────────────────────
# API key: console.anthropic.com → API Keys
# Model used: claude-haiku-4-5-20251001  (NEVER change to Sonnet/Opus)
ANTHROPIC_API_KEY=sk-ant-<your-key>

# ─── App URL ──────────────────────────────────────────────────────────────────
# Local dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (update after Vercel deploy):
# NEXT_PUBLIC_APP_URL=https://kindred.vercel.app
